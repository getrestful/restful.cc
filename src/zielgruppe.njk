---
layout: layout.njk
pagination:
  data: zgPages
  size: 1
  alias: zgp
  addAllPagesToCollections: true
permalink: "{{ ('/fuer/' + zgp.zg.key + '/') | l(zgp.lang) }}"
titleLocalized: true
eleventyComputed:
  dePath: "/fuer/{{ zgp.zg.key }}/"
  title: "{{ zgp.zg.title }}"
  description: "{{ zgp.zg.description }}"
---
{% from "icon.njk" import icon %}
{% from "macros.njk" import art, stepVisual, faqList, talk with context %}

<section class="zg-hero">
  <div class="wrap">
    <p class="crumb"><a href="{{ '/' | l }}">{{ "Startseite" | t }}</a> · {{ zg.menu }}</p>
    <div class="grid">
      <div>
        <span class="zg-label">{{ zg.label }}</span>
        <h1>{{ zg.h1 | safe }}</h1>
        <p class="sub">{{ zg.sub }}</p>
        <div class="ctas"><a class="btn btn-dark" href="#kontakt">{{ "Infotermin vereinbaren" | t }}</a><a class="btn btn-line" href="#ablauf">{{ zg.cta2 or ("So funktioniert es" | t) }}</a></div>
      </div>
      {{ art(zg.art, "blob") }}
    </div>
  </div>
</section>

<section class="pt0">
  <div class="wrap reasons">
    <div class="txt">
      <h2>{{ zg.reasonsTitle | safe }}</h2>
      <p>{{ zg.reasonsIntro }}</p>
      <a class="btn btn-dark" href="#kontakt">{{ "Infotermin vereinbaren" | t }}</a>
    </div>
    <div>
      {%- for r in zg.reasons %}
      <details{% if loop.first %} open{% endif %}><summary><span class="c">{{ icon("check", 20, 2) | safe }}</span><b>{{ r.title }}</b><span class="plus" aria-hidden="true">+</span></summary><div class="d-body"><p>{{ r.text }}</p></div></details>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="pt0">
  <div class="wrap">
    <p class="kicker">{{ "Zahlen und Fakten" | t }}</p>
    <h2>{{ "Warum es <i>sich lohnt</i>" | t | safe }}</h2>
    <div class="stats">
      {%- for s in zg.stats %}
      <div class="stat">{% if s.title %}<h3 class="stat-t">{{ s.title }}</h3>{% else %}<span class="v">{{ s.value }}</span>{% endif %}<p>{{ s.text }}</p>
        {%- if s.source %}<small>{{ "Quelle:" | t }} {% if s.url %}<a href="{{ s.url | l }}"{% if s.url.startsWith("http") %} target="_blank" rel="noopener"{% endif %}>{{ s.source }}</a>{% else %}{{ s.source }}{% endif %}</small>{% endif -%}
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

{%- if zg.cases %}
<section id="ablauf" class="pt0">
  <div class="wrap">
    <p class="kicker">{{ "Beispiele aus der Praxis" | t }}</p>
    <h2>{{ "Gemeinschaften, <i>die bereits laufen</i>" | t | safe }}</h2>
    <div class="partner-grid">
      {%- for c in zg.cases %}
      <a class="partner" href="{{ c.href }}" target="_blank" rel="noopener"><div class="lg"><img src="/images/{{ c.logo }}" alt="" loading="lazy"></div><div><b>{{ c.name }}</b><span>{{ c.text }}</span></div><span class="sr-only"> {{ "(öffnet in neuem Fenster)" | t }}</span></a>
      {%- endfor %}
    </div>
  </div>
</section>
{%- else %}
<section id="ablauf" class="pt0">
  <div class="wrap">
    <p class="kicker">{{ "So funktioniert es" | t }}</p>
    <h2>{{ "So einfach <i>startet die Begleitung</i>" | t | safe }}</h2>
    <div class="zz">
      {%- for s in zg.steps %}
      <div class="zz-row">
        {{ stepVisual(s.visual) }}
        <div class="zz-txt"><span class="n">{{ loop.index }}</span><h3>{{ s.title }}</h3><p>{{ s.text }}</p></div>
      </div>
      {%- endfor %}
    </div>
    <p class="mt56"><a class="ev-link" href="{{ '/loesungen/peer-plattform/' | l }}">{{ "So sieht die Plattform aus →" | t }}</a></p>
  </div>
</section>
{%- endif %}

{%- if "trust" not in (zg.hide or []) %}
<section class="trust">
  <div class="wrap">
    <h2>{{ "restful arbeitet <i>evidenzbasiert und methodisch fundiert</i>" | t | safe }}</h2>
    <div class="trust-row">
      <div><span class="c">{{ icon("book") | safe }}</span><span>{{ "Gestützt auf Literaturrecherchen" | t }}</span></div>
      <div><span class="c">{{ icon("uni") | safe }}</span><span>{{ "Begleitforschung mit einer Universität" | t }}</span></div>
      <div><span class="c">{{ icon("shield") | safe }}</span><span>{{ "Schweizer Datenschutz (revDSG)" | t }}</span></div>
      <div><span class="c">{{ icon("users") | safe }}</span><span>{{ "{n} Partnerorganisationen" | t({ n: initiatives | length }) }}</span></div>
    </div>
  </div>
</section>
{%- endif %}

{%- if "quote" not in (zg.hide or []) %}
<section>
  <div class="wrap">
    {%- if zg.quote.type == "statement" %}
    <figure class="quote2">
      <small class="label">{{ zg.quote.label }}</small>
      <blockquote><p>{{ zg.quote.text }}</p></blockquote>
    </figure>
    {%- else %}
    <figure class="quote2">
      <small class="label">{{ "Stimme einer Partnerorganisation" | t }}</small>
      <blockquote><p>{{ "«{q}»" | t({ q: testimonial.excerpt }) }}</p></blockquote>
      <figcaption><b>{{ testimonial.name }}</b>, {{ testimonial.role }}</figcaption>
    </figure>
    {%- endif %}
  </div>
</section>
{%- endif %}

<section class="pt0">
  <div class="wrap">
    <p class="kicker">{{ "Wissenschaftlicher Nachweis" | t }}</p>
    <h2>{{ "Fundiert, <i>nicht nur gut gemeint</i>" | t | safe }}</h2>
    <div class="evref">
      {%- for e in zg.evidence %}
      <div class="evc {{ 'bg-sand' if loop.first else 'bg-lav' }}">
        <small>{{ "Evidenz" | t }} · {{ e.label }}</small>
        <p class="find">{{ e.finding }}</p>
        <span class="cite"><a href="{{ e.url }}" target="_blank" rel="noopener">{{ e.cite }} ↗</a></span>
        <a href="{{ ('/wissenschaft/#' + e.topic) | l }}">{{ "Studienlage zu {x} →" | t({ x: e.label }) }}</a>
      </div>
      {%- endfor %}
      {%- if zg.reference %}
      <div class="evc refc">
        <small>{{ zg.reference.title }}</small>
        <p class="ref-txt">{{ zg.reference.text | safe }}</p>
        {%- if zg.reference.logos.length %}
        <div class="logos2">{% for lg in zg.reference.logos %}<img src="/images/{{ lg.file }}" alt="{{ lg.alt }}" loading="lazy">{% endfor %}</div>
        {%- endif %}
      </div>
      {%- endif %}
      {%- if (zg.evidence.length + (1 if zg.reference else 0)) % 2 == 1 %}
      <div class="evc refc">
        <small>{{ "Alle Themen" | t }}</small>
        <p class="find">{{ "Studienlage zu {n} Themenfeldern, von Demenz bis Onkologie." | t({ n: themenfelder | length }) }}</p>
        <a href="{{ '/wissenschaft/' | l }}">{{ "Zu Methode & Evidenz →" | t }}</a>
      </div>
      {%- endif %}
    </div>
  </div>
</section>

{%- if zg.commelia %}
{%- set cm = digitalprojekte.commelia %}
<section class="pt0" aria-labelledby="cm-titel">
  <div class="wrap">
    <article class="cm cm-teaser">
      <div class="cm-txt">
        <span class="cm-badge">{{ "Auch von restful: Commelia" | t }}</span>
        <h3 id="cm-titel">{{ zg.commelia.title | safe }}</h3>
        <p class="in">{{ zg.commelia.text }}</p>
        <ul class="cm-list">
          {%- for it in zg.commelia.items %}
          <li><span class="c">{{ icon("check", 14, 2.6) | safe }}</span>{{ it }}</li>
          {%- endfor %}
        </ul>
        <div class="cm-ctas">
          <a class="btn btn-violet" href="{{ '/loesungen/commelia/' | l }}">{{ "Commelia kennenlernen" | t }}</a>
          <small>{{ "30 Tage kostenlos testen, keine Kreditkarte nötig." | t }}</small>
        </div>
      </div>
      <div class="cm-vis"><img src="/images/{{ cm.image }}" width="1020" height="880" loading="lazy" alt="{{ cm.imageAlt }}"></div>
    </article>
  </div>
</section>
{%- endif %}

<section class="pt0" aria-labelledby="faq-titel">
  <div class="wrap faq">
    <div><p class="kicker">FAQ</p><h2 id="faq-titel">{{ "Häufige <i>Fragen</i>" | t | safe }}</h2></div>
    <div>{{ faqList(zg.faq) }}</div>
  </div>
</section>

<section id="kontakt" class="pt0">
  <div class="wrap">
    {{ talk(person=zg.contactPerson) }}
    <p class="kicker mt60">{{ "restful in anderen Settings" | t }}</p>
    <nav class="others" aria-label="{{ 'restful in anderen Settings' | t }}">
      <a href="{{ '/' | l }}">{{ "Patientenorganisationen und Ligen" | t }}<span aria-hidden="true">→</span></a>
      {%- for o in zielgruppen %}{% if o.key != zg.key %}
      <a href="{{ ('/fuer/' + o.key + '/') | l }}">{{ o.menu }}<span aria-hidden="true">→</span></a>
      {%- endif %}{% endfor %}
    </nav>
  </div>
</section>
