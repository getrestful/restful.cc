---
layout: layout.njk
pagination: { data: langs, size: 1, alias: lang, addAllPagesToCollections: true }
permalink: "{{ '/loesungen/commelia/' | l(lang) }}"
dePath: /loesungen/commelia/
title: "Commelia: Chat-Beratung mit KI-Unterstützung · restful"
description: "Commelia bündelt Web-Chat, E-Mail und WhatsApp in einem Posteingang. Fachpersonen und Peers antworten gemeinsam, ein KI-Assistent übernimmt Routinefragen."
---
{% from "icon.njk" import icon %}
{%- set cm = digitalprojekte.commelia %}

<section class="zg-hero">
  <div class="wrap">
    <p class="crumb"><a href="{{ '/' | l }}">{{ "Startseite" | t }}</a> · <a href="{{ '/loesungen/' | l }}">{{ "Lösungen" | t }}</a> · {{ "Commelia" | t }}</p>
    <div class="grid">
      <div>
        <span class="zg-label">{{ "Commelia: Chat-Beratung" | t }}</span>
        <h1>{{ "Support von Mensch zu Mensch, <i>mit einer Prise KI</i>" | t | safe }}</h1>
        <p class="sub">{{ "Commelia vereint Web-Chat, E-Mail und WhatsApp in einem ruhigen Posteingang. Euer Team aus Fachpersonen und Peers antwortet gemeinsam, ein KI-Assistent übernimmt Routinefragen und weiss, wann ein Mensch übernehmen soll." | t }}</p>
        <div class="ctas"><a class="btn btn-violet" href="{{ cm.url }}" target="_blank" rel="noopener">{{ "30 Tage kostenlos testen" | t }}</a><a class="btn btn-line" href="#kontakt">{{ "Infotermin vereinbaren" | t }}</a></div>
      </div>
      <div class="cm-vis cm-hero"><img src="/images/{{ cm.image }}" width="1020" height="880" alt="{{ cm.imageAlt }}"></div>
    </div>
  </div>
</section>

<section class="pt0" aria-labelledby="kann-titel">
  <div class="wrap">
    <p class="kicker">{{ "Was Commelia kann" | t }}</p>
    <h2 id="kann-titel">{{ "Ein simples, intuitives Werkzeug <i>ohne lange Schulungen</i>" | t | safe }}</h2>
    <div class="tasks tasks-3">
      {%- for f in commeliaseite.features %}
      <div class="task"><span class="c">{{ icon(f.icon) | safe }}</span><h3>{{ f.title }}</h3><p>{{ f.text }}</p></div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="pt0" aria-labelledby="wo-titel">
  <div class="wrap">
    <p class="kicker">{{ "Wo Commelia hilft" | t }}</p>
    <h2 id="wo-titel">{{ "Für Organisationen, die Menschen <i>in herausfordernden Situationen helfen</i>" | t | safe }}</h2>
    <div class="uc-grid">
      {%- for u in commeliaseite.einsatz %}
      <div class="uc">
        <h3>{{ u.title }}</h3>
        <p>{{ u.text }}</p>
        {%- if u.url %}<a class="ev-link" href="{{ u.url | l }}">{{ u.link }} →</a>{% endif %}
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="pt0" aria-labelledby="wie-titel">
  <div class="wrap">
    <p class="kicker">{{ "Mit oder ohne restful" | t }}</p>
    <h2 id="wie-titel">{{ "So startet <i>ihr mit Commelia</i>" | t | safe }}</h2>
    <div class="research">
      <div class="bg-lav">
        <h3>{{ "Direkt loslegen" | t }}</h3>
        <p>{{ "Commelia selbst einrichten und 30 Tage kostenlos testen. Keine Kreditkarte nötig, Rabatte für gemeinnützige Organisationen." | t }}</p>
        <p class="mt30"><a class="btn btn-violet" href="{{ cm.url }}" target="_blank" rel="noopener">{{ "Zu commelia.ch ↗" | t }}</a></p>
      </div>
      <div class="bg-sand">
        <h3>{{ "Gemeinsam mit restful" | t }}</h3>
        <p>{{ "Wir richten Commelia mit euch ein, verbinden es mit eurem Peer-Angebot und begleiten Einführung, Rollen und Auswertung." | t }}</p>
        <p class="mt30"><a class="btn btn-dark" href="#kontakt">{{ "Infotermin vereinbaren" | t }}</a></p>
      </div>
    </div>
  </div>
</section>

<section class="pt0" aria-labelledby="weitere-titel">
  <div class="wrap">
    <p class="kicker">{{ "Weitere Lösungen" | t }}</p>
    <h2 class="h-sm" id="weitere-titel">{{ "Was sich <i>damit verbinden lässt</i>" | t | safe }}</h2>
    {%- set exclude = "commelia" %}
    {% include "loesungen-karten.njk" %}
  </div>
</section>

<section id="kontakt" class="pt0">
  <div class="wrap">
    <div class="contact-box compact">
      <div>
        <h2>{{ "Lieber <i>live sehen?</i>" | t | safe }}</h2>
        <p>{{ "Wir zeigen dir Commelia gerne in einem unverbindlichen Infotermin." | t }}</p>
        <p class="mail">{{ "Direkt per" | t }} <a href="mailto:{{ site.email }}">{{ "E-Mail|im Satz" | t }}</a></p>
      </div>
      <a class="btn btn-dark" href="{{ '/#kontakt' | l }}">{{ "Infotermin vereinbaren" | t }}</a>
    </div>
  </div>
</section>
