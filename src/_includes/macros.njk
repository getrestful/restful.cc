<span class="mini" aria-hidden="true"><svg viewBox="0 0 64 64">
{%- if v == "paar" %}
  <circle cx="25" cy="34" r="16" fill="#7066F6" opacity=".9" style="mix-blend-mode:multiply"/><circle cx="40" cy="30" r="16" fill="#BC9C96" style="mix-blend-mode:multiply"/>
{%- elif v == "ergaenzung" %}
  <circle cx="28" cy="34" r="20" fill="#BC9C96"/><circle cx="50" cy="20" r="9" fill="#7066F6" opacity=".9"/>
{%- elif v == "drei" %}
  <circle cx="24" cy="26" r="14" fill="#7066F6" opacity=".88" style="mix-blend-mode:multiply"/><circle cx="40" cy="26" r="14" fill="#BC9C96" style="mix-blend-mode:multiply"/><circle cx="32" cy="40" r="14" fill="none" stroke="#05004A" stroke-width="1.5" opacity=".6"/>
{%- elif v == "suche" %}
  <circle cx="28" cy="28" r="17" fill="#BC9C96"/><circle cx="28" cy="28" r="9" fill="#7066F6" opacity=".9"/><path d="M41 41l12 12" stroke="#05004A" stroke-width="3" stroke-linecap="round"/>
{%- elif v == "bogen" %}
  <path d="M14 56V34a18 18 0 0 1 36 0v22Z" fill="#7066F6" opacity=".9" style="mix-blend-mode:multiply"/><circle cx="46" cy="20" r="11" fill="#BC9C96" style="mix-blend-mode:multiply"/>
{%- elif v == "match" %}
  <circle cx="16" cy="32" r="10" fill="#7066F6" opacity=".9"/><circle cx="48" cy="32" r="10" fill="#BC9C96"/><path d="M27 32h10" stroke="#05004A" stroke-width="2" stroke-dasharray="2 3" stroke-linecap="round"/><circle cx="32" cy="14" r="4" fill="#05004A"/>
{%- else %}
  <rect x="10" y="36" width="10" height="18" rx="5" fill="#BC9C96"/><rect x="27" y="24" width="10" height="30" rx="5" fill="#7066F6" opacity=".9"/><rect x="44" y="12" width="10" height="42" rx="5" fill="#05004A"/>
{%- endif %}
</svg></span>
{% endmacro %}

{# Kontaktformular: öffnet das E-Mail-Programm mit einer vorbereiteten Nachricht (siehe site.js). #}
{% macro contactForm(email, id="k") %}
<form class="kform" action="mailto:{{ email }}" method="post" enctype="text/plain" data-contact data-to="{{ email }}">
  <label class="sr-only" for="{{ id }}-name">Name</label>
  <input id="{{ id }}-name" name="Name" autocomplete="name" placeholder="Name" required>
  <label class="sr-only" for="{{ id }}-org">Organisation</label>
  <input id="{{ id }}-org" name="Organisation" autocomplete="organization" placeholder="Organisation">
  <label class="sr-only" for="{{ id }}-mail">E-Mail</label>
  <input id="{{ id }}-mail" name="E-Mail" type="email" autocomplete="email" placeholder="E-Mail" required>
  <label class="sr-only" for="{{ id }}-msg">Nachricht</label>
  <textarea id="{{ id }}-msg" name="Nachricht" rows="4" placeholder="Worum geht es?" required></textarea>
  <p class="form-note">Beim Senden öffnet sich dein E-Mail-Programm mit der fertigen Nachricht an <a href="mailto:{{ email }}">{{ email }}</a>. Mehr dazu in der <a href="/datenschutzerklaerung/">Datenschutzerklärung</a>.</p>
  <button class="btn btn-dark" type="submit">Per E-Mail senden</button>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>
{% endmacro %}

{# Chat-Ausschnitt als Beispielansicht #}
{% macro chatMock() %}
<div class="chat">
  <div class="top"><i></i><div><b>Anna, Peer</b><small>Ähnliche Erfahrung</small></div></div>
  <div class="msgs">
    <div class="m">Hallo! Schön, dass du dich meldest. Wie geht es dir gerade?</div>
    <div class="m me">Ehrlich gesagt bin ich ziemlich überfordert mit allem.</div>
    <div class="m">Das kenne ich gut. Mir hat damals geholfen, eins nach dem anderen anzugehen.</div>
    <div class="m me">Wie hast du das gemacht?</div>
  </div>
</div>
{% endmacro %}

{# Auswertung als Beispielansicht mit fiktiven Werten #}
{% macro reportMock() %}
<div class="browser">
  <div class="bar"><i></i><i></i><i></i><span>Auswertung</span></div>
  <div class="dash">
    <div class="main">
      <div class="kpis">
        <div class="kpi"><small>Aktive Mitglieder</small><b>148</b></div>
        <div class="kpi"><small>Matches</small><b>36</b></div>
        <div class="kpi"><small>Zufriedenheit</small><b>4,6</b></div>
      </div>
      <div class="rows">
        <b class="rows-title">Fühle mich besser unterstützt</b>
        <div class="r"><i></i><div class="bar2 w85"></div><em class="ok">trifft zu</em></div>
        <div class="r"><i></i><div class="bar2 w60"></div><em>eher</em></div>
        <div class="r"><i></i><div class="bar2 w20"></div><em>kaum</em></div>
      </div>
    </div>
  </div>
</div>
{% endmacro %}

{# Bild zu einem Ablaufschritt auf den Zielgruppenseiten #}
{% macro stepVisual(v) %}
<figure class="zz-vis">
{%- if v == "screen-1" %}
  <div class="phone"><div class="scr"><img src="/images/vision-screen-1.jpg" width="640" height="1170" loading="lazy" alt="Startseite des Peer-Angebots von Demenzworld auf dem Smartphone"></div></div>
  <figcaption>Beispiel aus einem Partnerangebot (Demenzworld)</figcaption>
{%- elif v == "screen-2" %}
  <div class="phone"><div class="scr"><img src="/images/vision-screen-2.jpg" width="640" height="1161" loading="lazy" alt="Einstieg ins Angebot von Cystische Fibrose Schweiz mit der Frage: Was ist deine Situation?"></div></div>
  <figcaption>Beispiel aus einem Partnerangebot (Cystische Fibrose Schweiz)</figcaption>
{%- elif v == "screen-3" %}
  <div class="phone"><div class="scr"><img src="/images/vision-screen-3.jpg" width="640" height="1110" loading="lazy" alt="Erklärung, wie MucoConnect in drei Schritten funktioniert, beginnend mit einem anonymen Fragebogen"></div></div>
  <figcaption>Beispiel aus einem Partnerangebot (MucoConnect)</figcaption>
{%- elif v == "chat" %}
  <div class="phone"><div class="scr">{{ chatMock() }}</div></div>
  <figcaption>Beispielansicht</figcaption>
{%- else %}
  {{ reportMock() }}
  <figcaption>Beispielansicht mit fiktiven Werten</figcaption>
{%- endif %}
</figure>
{% endmacro %}

{# Aufklappbare Fragen und Antworten #}
{% macro faqList(items) %}
{%- for f in items %}
<details><summary><b>{{ f.q }}</b><span class="plus" aria-hidden="true">+</span></summary><div class="d-body"><p>{{ f.a }}</p></div></details>
{%- endfor %}
{% endmacro %}
