{# Erfolgsmeldung nach dem Matching, vereinfachte Beispielansicht #}
{% macro matchMock() %}
<div class="match">
  <span class="ok" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
  <b class="t">Wir haben jemanden für dich gefunden</b>
  <div class="peer"><i></i><div><b>Anna, Peer</b><small>Ähnliche Diagnose und Behandlung</small></div></div>
  <span class="cta">Anna kennenlernen</span>
  <small class="safe">Deine Angaben bleiben geschützt</small>
</div>
{% endmacro %}

{# Monitoring und Wirkung, vereinfachte Beispielansicht mit fiktiven Werten #}
{% macro monitorMock(note="Rückfrage an Fachperson weitergeleitet") %}
<div class="browser">
  <div class="bar"><i></i><i></i><i></i><span>Auswertung und Wirkung</span></div>
  <div class="dash">
    <div class="main">
      <div class="kpis">
        <div class="kpi"><small>Aktive Begleitungen</small><b>24</b></div>
        <div class="kpi"><small>Offene Rückfragen</small><b>2</b></div>
        <div class="kpi"><small>Zufriedenheit</small><b>4,6</b></div>
      </div>
      <div class="rows">
        <b class="rows-title">Wohlbefinden seit Start der Begleitung</b>
        <div class="r"><i></i><div class="bar2 w85"></div><em class="ok">besser</em></div>
        <div class="r"><i></i><div class="bar2 w20"></div><em>gleich</em></div>
      </div>
      <div class="alert"><span aria-hidden="true">!</span>{{ note }}</div>
    </div>
  </div>
</div>
{% endmacro %}

{# Bild zu einem Ablaufschritt auf den Zielgruppenseiten #}
{% macro stepVisual(v) %}
<figure class="zz-vis">
{%- if v == "screen-1" %}
  <div class="phone"><div class="scr"><img src="/images/vision-screen-1.jpg" width="640" height="1170" loading="lazy" alt="Startseite des Peer-Angebots von Demenzworld auf dem Smartphone"></div></div>
  <figcaption>Beispiel aus einem Partnerangebot (Demenzworld)</figcaption>
{%- elif v == "screen-2" %}
  <div class="phone"><div class="scr"><img src="/images/vision-screen-2.jpg" width="640" height="1161" loading="lazy" alt="Einstieg ins Angebot von Cystische Fibrose Schweiz mit der Frage: Was ist deine Situation?"></div></div>
  <figcaption>Beispiel aus einem Partnerangebot (Cystische Fibrose Schweiz)</figcaption>
{%- elif v == "screen-3" %}
  <div class="phone"><div class="scr"><img src="/images/vision-screen-3.jpg" width="640" height="1110" loading="lazy" alt="Erklärung, wie MucoConnect in drei Schritten funktioniert, beginnend mit einem anonymen Fragebogen"></div></div>
  <figcaption>Beispiel aus einem Partnerangebot (MucoConnect)</figcaption>
{%- elif v == "landing" %}
  {{ landingMock() }}
  <figcaption>Beispiel eines co-gebrandeten Startpunkts</figcaption>
{%- elif v == "landing-versicherer" %}
  {{ landingMock("Logo Versicherung", ["Chronische Erkrankung", "Psychische Belastung", "Pflegende Angehörige"]) }}
  <figcaption>Beispiel eines co-gebrandeten Startpunkts</figcaption>
{%- elif v == "dashboard-versicherer" %}
  {{ monitorMock("Anonymisierter Quartalsbericht bereit") }}
  <figcaption>Beispielansicht mit fiktiven Werten</figcaption>
{%- elif v == "match" %}
  <div class="phone"><div class="scr">{{ matchMock() }}</div></div>
  <figcaption>Beispielansicht</figcaption>
{%- elif v == "dashboard" %}
  {{ monitorMock() }}
  <figcaption>Beispielansicht mit fiktiven Werten</figcaption>
{%- elif v == "chat" %}
  <div class="phone"><div class="scr">{{ chatMock() }}</div></div>
  <figcaption>Beispielansicht</figcaption>
{%- else %}
  {{ reportMock() }}
  <figcaption>Beispielansicht mit fiktiven Werten</figcaption>
{%- endif %}
</figure>
{% endmacro %}

{# Aufklappbare Fragen und Antworten #}
{% macro faqList(items) %}
{%- set entities = [] %}
{%- for f in items %}
<details><summary><b>{{ f.q }}</b><span class="plus" aria-hidden="true">+</span></summary><div class="d-body"><p>{{ f.a | safe }}</p></div></details>
{%- set entities = (entities.push({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a | striptags } }), entities) %}
{%- endfor %}
<script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": entities } | dump | safe }}</script>
{% endmacro %}
