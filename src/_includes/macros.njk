{# Markenbild statt Fotos: zwei sich überlagernde Formen stehen für zwei Menschen im Austausch.
   v: 0 Startseite, 1 IV-Stellen, 2 Spitäler, 3 Industrie, 4 Versicherer · shape: arch oder blob #}
{% macro art(v, shape="blob") %}
<div class="art art-{{ shape }}" aria-hidden="true">
{%- if shape == "arch" %}
  <svg viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice">
    <circle cx="168" cy="222" r="118" fill="#7066F6" opacity=".9" style="mix-blend-mode:multiply"/>
    <circle cx="248" cy="318" r="118" fill="#BC9C96" style="mix-blend-mode:multiply"/>
    <circle cx="300" cy="120" r="16" fill="#05004A"/>
    <circle cx="96" cy="410" r="9" fill="#8E5147"/>
  </svg>
{%- else %}
  <svg viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice">
  {%- if v == 1 %}
    <circle cx="150" cy="248" r="100" fill="#7066F6" opacity=".9" style="mix-blend-mode:multiply"/>
    <circle cx="240" cy="170" r="76" fill="#BC9C96" style="mix-blend-mode:multiply"/>
    <circle cx="302" cy="104" r="20" fill="#05004A"/>
    <circle cx="96" cy="128" r="8" fill="#8E5147"/>
  {%- elif v == 2 %}
    <path d="M96 420V242a104 104 0 0 1 208 0v178Z" fill="#7066F6" opacity=".9" style="mix-blend-mode:multiply"/>
    <circle cx="276" cy="160" r="78" fill="#BC9C96" style="mix-blend-mode:multiply"/>
    <circle cx="120" cy="116" r="14" fill="#05004A"/>
  {%- elif v == 5 %}
    <circle cx="214" cy="214" r="150" fill="none" stroke="#05004A" stroke-width="1.5" stroke-dasharray="2 7" stroke-linecap="round" opacity=".45"/>
    <circle cx="150" cy="262" r="78" fill="#7066F6" opacity=".9" style="mix-blend-mode:multiply"/>
    <circle cx="236" cy="196" r="96" fill="#BC9C96" style="mix-blend-mode:multiply"/>
    <circle cx="318" cy="104" r="18" fill="#05004A"/>
    <circle cx="88" cy="132" r="8" fill="#8E5147"/>
  {%- elif v == 3 %}
    <circle cx="160" cy="170" r="90" fill="#7066F6" opacity=".88" style="mix-blend-mode:multiply"/>
    <circle cx="244" cy="170" r="90" fill="#BC9C96" style="mix-blend-mode:multiply"/>
    <circle cx="202" cy="246" r="90" fill="none" stroke="#05004A" stroke-width="2" opacity=".55"/>
    <circle cx="318" cy="318" r="12" fill="#05004A"/>
  {%- else %}
    <circle cx="200" cy="200" r="152" fill="none" stroke="#05004A" stroke-width="1.5" opacity=".3"/>
    <circle cx="200" cy="204" r="112" fill="#BC9C96" style="mix-blend-mode:multiply"/>
    <circle cx="238" cy="166" r="68" fill="#7066F6" opacity=".9" style="mix-blend-mode:multiply"/>
    <circle cx="318" cy="300" r="12" fill="#05004A"/>
  {%- endif %}
  </svg>
{%- endif %}
</div>
{% endmacro %}

{# Kleine Bildmarke im Stil der Hero-Visualisierung, z.B. für Einordnung und Methode #}
