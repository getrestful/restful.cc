{% from "icon.njk" import icon %}
{%- set htmlLang = { de: "de-CH", fr: "fr-CH", en: "en" } -%}
{%- set ogLocale = { de: "de_CH", fr: "fr_CH", en: "en_GB" } -%}
{%- set pageTitle = title if titleLocalized else ((title or "restful · Gegenseitige Unterstützung, die nachweislich wirkt") | t) -%}
{%- set pageDesc = (description if titleLocalized else (description | t)) if description else "" -%}
<!doctype html>
<html lang="{{ htmlLang[locale] }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  {%- if pageDesc %}
  <meta name="description" content="{{ pageDesc }}">
  {%- endif %}
  {%- if site.noindex or noindex %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  {%- if redirectTo %}
  <meta http-equiv="refresh" content="0; url={{ redirectTo }}">
  {%- endif %}
  {%- set canonical = site.url + (redirectTo or page.url) %}
  {%- if page.url != "/404.html" %}
  <link rel="canonical" href="{{ canonical }}">
  {%- endif %}
  {%- if dePath %}
  {%- for lng in langs %}
  <link rel="alternate" hreflang="{{ htmlLang[lng] }}" href="{{ site.url }}{{ dePath | l(lng) }}">
  {%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ dePath }}">
  {%- endif %}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ ogLocale[locale] }}">
  <meta property="og:site_name" content="restful">
  <meta property="og:url" content="{{ deploy.url }}{{ redirectTo or page.url }}">
  <meta property="og:title" content="{{ pageTitle }}">
  {%- if pageDesc %}
  <meta property="og:description" content="{{ pageDesc }}">
  {%- endif %}
  <meta property="og:image" content="{{ deploy.url }}{{ site.ogImage }}">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:alt" content="{{ 'restful: Peer-Support, der nachweislich wirkt' | t }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  {%- if pageDesc %}
  <meta name="twitter:description" content="{{ pageDesc }}">
  {%- endif %}
  <meta name="twitter:image" content="{{ deploy.url }}{{ site.ogImage }}">
  {%- if dePath == "/" %}
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "Organization", "@id": site.url + "/#org", "name": site.name, "legalName": site.legalName, "url": site.url + "/", "logo": site.url + "/images/logo.svg", "email": site.email,
        "address": { "@type": "PostalAddress", "streetAddress": site.street, "postalCode": site.zip, "addressLocality": site.city, "addressCountry": "CH" } },
      { "@type": "WebSite", "@id": site.url + "/#website", "url": site.url + ("/" | l), "name": site.name, "inLanguage": htmlLang[locale], "publisher": { "@id": site.url + "/#org" } }
    ]
  } | dump | safe }}</script>
  {%- endif %}
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/fraunces-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/site.css">
  <script>document.documentElement.classList.replace('no-js','js')</script>
  <script src="/js/site.js" defer></script>
  {%- if site.matomo %}
  <!-- Matomo -->
  <script>
    var _paq = window._paq = window._paq || [];
    /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
    _paq.push(['disableCookies']);
    _paq.push(['trackPageView']);
    _paq.push(['enableLinkTracking']);
    (function() {
      var u="{{ site.matomo.url }}";
      _paq.push(['setTrackerUrl', u+'matomo.php']);
      _paq.push(['setSiteId', '{{ site.matomo.siteId }}']);
      var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
      g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
    })();
  </script>
  <!-- End Matomo Code -->
  {%- endif %}
</head>
<body>
<a class="skip" href="#inhalt">{{ "Zum Inhalt springen" | t }}</a>

{%- set langNames = { de: "Deutsch", fr: "Français", en: "English" } %}
{%- macro langSwitch(cls) %}
<nav class="lang {{ cls }}" aria-label="{{ 'Sprache' | t }}">
  {%- for lng in langs %}
  <a href="{{ (dePath or '/') | l(lng) }}" hreflang="{{ htmlLang[lng] }}" lang="{{ htmlLang[lng] }}"{% if lng == locale %} aria-current="true"{% endif %}><span aria-hidden="true">{{ lng | upper }}</span><span class="sr-only">{{ langNames[lng] }}</span></a>
  {%- endfor %}
</nav>
{%- endmacro %}

{%- if minimalHeader %}
<header class="site">
  <div class="wrap nav">
    <a class="logo" href="{{ '/' | l }}"><img src="/images/logo.svg" alt="{{ 'restful, zur Startseite' | t }}" width="129" height="38"></a>
    <span class="nav-label">{{ minimalHeader | t }}</span>
  </div>
</header>
{%- else %}
<header class="site" data-header>
  <div class="wrap nav">
    <a class="logo" href="{{ '/' | l }}"><img src="/images/logo.svg" alt="{{ 'restful, zur Startseite' | t }}" width="129" height="38"></a>
    <nav aria-label="{{ 'Hauptnavigation' | t }}">
      <ul id="hauptmenue">
        <li class="dd">
          <button type="button" aria-expanded="false" aria-controls="fuer-wen">{{ "Für wen" | t }} <span aria-hidden="true">▾</span></button>
          <div class="dd-menu" id="fuer-wen">
            <a href="{{ '/' | l }}"{% if dePath == "/" %} aria-current="page"{% endif %}>{{ "Patientenorganisationen und Ligen" | t }}</a>
            {%- for z in zielgruppen %}
            {%- set zPath = "/fuer/" + z.key + "/" %}
            <a href="{{ zPath | l }}"{% if dePath == zPath %} aria-current="page"{% endif %}>{{ z.menu }}</a>
            {%- endfor %}
          </div>
        </li>
        <li><a href="{{ '/#nutzen' | l }}">{{ "Nutzen" | t }}</a></li>
        <li class="dd dd-link">
          <a href="{{ '/loesungen/' | l }}"{% if dePath and dePath.startsWith("/loesungen/") %} aria-current="page"{% endif %}>{{ "Lösungen" | t }} <span aria-hidden="true">▾</span></a>
          <div class="dd-menu">
            {%- for s in loesungen %}
            <a href="{{ s.url | l }}"{% if dePath == s.url %} aria-current="page"{% endif %}>{{ s.title }}</a>
            {%- endfor %}
          </div>
        </li>
        <li><a href="{{ '/ueber-uns/' | l }}"{% if dePath == "/ueber-uns/" %} aria-current="page"{% endif %}>{{ "Über uns" | t }}</a></li>
        <li class="lang-item">{{ langSwitch("lang-menu") }}</li>
      </ul>
    </nav>
    <div class="nav-end">
      {{ langSwitch("lang-bar") }}
      <a class="btn btn-dark" href="{{ ('/#kontakt' | l) if noContact else '#kontakt' }}">{{ "Infotermin" | t }}</a>
    </div>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="hauptmenue" data-menu-btn>{{ icon("menu", 22, 2) | safe }}<span class="sr-only">{{ "Menü" | t }}</span></button>
  </div>
</header>
{%- endif %}

<main id="inhalt">
{{ content | safe }}
</main>

<footer class="site">
  <div class="wrap">
    <address>{{ site.legalName }}, {{ site.street }}, {{ site.zip }} {{ site.city }}</address>
    <nav aria-label="{{ 'Fusszeile' | t }}">
      <a href="{{ '/loesungen/' | l }}">{{ "Lösungen" | t }}</a>
      <a href="{{ '/wissenschaft/' | l }}">{{ "Methode & Evidenz" | t }}</a>
      <a href="{{ '/datenschutzerklaerung/' | l }}">{{ "Datenschutz" | t }}</a>
      <a href="{{ site.jobsUrl }}" target="_blank" rel="noopener">{{ "Offene Stellen" | t }}</a>
      <a href="mailto:{{ site.email }}">{{ "E-Mail" | t }}</a>
    </nav>
  </div>
</footer>
</body>
</html>
