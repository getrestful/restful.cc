{#- Karten der Lösungen mit Produktvorschau. Optional: exclude = key der aktuellen Seite #}
<div class="sol-grid{% if exclude %} sol-grid-2{% endif %}">
  {%- for sol in loesungen %}{% if sol.key != exclude %}
  {%- set m = sol.mock %}
  <a class="sol bg-{{ sol.tone }}" href="{{ sol.url | l }}">
    <div class="sol-vis{% if m.front %} has-front{% endif %}">
      <div class="mk-browser"><span class="mk-bar" aria-hidden="true"><i></i><i></i><i></i></span><img src="/images/{{ m.back.img }}" width="{{ m.back.w }}" height="{{ m.back.h }}" loading="lazy" alt="{{ m.back.alt }}"></div>
      {%- if m.front %}
      <div class="mk-{{ m.front.type }}"><img src="/images/{{ m.front.img }}" width="{{ m.front.w }}" height="{{ m.front.h }}" loading="lazy" alt="{{ m.front.alt }}"></div>
      {%- endif %}
    </div>
    <h3>{{ sol.title }}</h3>
    <p>{{ sol.text }}</p>
    <span class="go">{{ "Mehr erfahren →" | t }}</span>
  </a>
  {%- endif %}{% endfor %}
</div>
