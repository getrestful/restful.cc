<!doctype html>
<html lang="de-CH">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description or title }}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="stylesheet" href="/css/output.css">
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
</head>
<body class="bg-paper font-sans text-base text-ink antialiased">
  <a href="#inhalt" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-ink focus:px-4 focus:py-2 focus:text-paper">Zum Inhalt springen</a>

  <header class="border-b border-line bg-paper">
    <div class="mx-auto flex max-w-content flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-4 sm:px-8">
      <a href="/" class="flex shrink-0 items-center rounded focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
        <img src="/images/logo.svg" alt="restful" class="h-7 w-auto">
      </a>
      <nav aria-label="Hauptnavigation">
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <li><a href="/wissenschaft/" class="rounded underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent" {% if page.url == "/wissenschaft/" %}aria-current="page"{% endif %}>Wissenschaft</a></li>
          <li><a href="/ueber-restful/" class="rounded underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent" {% if page.url == "/ueber-restful/" %}aria-current="page"{% endif %}>Über restful</a></li>
          <li><a href="#kontakt" class="inline-block rounded-full bg-accent px-5 py-2.5 font-medium text-paper hover:bg-accent-strong focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">Kontakt aufnehmen</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="inhalt">
    {{ content | safe }}
  </main>

  <footer class="border-t border-line bg-surface">
    <div class="mx-auto grid max-w-content gap-12 px-5 py-section-sm sm:px-8 md:grid-cols-[3fr_2fr] md:py-section">
      <section id="kontakt" aria-labelledby="kontakt-titel" class="scroll-mt-8">
        <h2 id="kontakt-titel" class="text-h2 font-semibold">Lasst uns sprechen</h2>
        <p class="mt-3 max-w-prose text-ink-soft">Erzählt uns kurz, wo ihr steht. Wir melden uns innert weniger Arbeitstage für ein unverbindliches Erstgespräch.</p>
        <form class="mt-8 grid max-w-xl gap-5" action="#" method="post" data-kontaktformular>
          <div class="grid gap-2">
            <label for="kontakt-name" class="font-medium">Name</label>
            <input id="kontakt-name" name="name" type="text" autocomplete="name" required class="rounded-lg border border-line bg-paper px-4 py-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
          </div>
          <div class="grid gap-2">
            <label for="kontakt-organisation" class="font-medium">Organisation <span class="font-normal text-ink-soft">(optional)</span></label>
            <input id="kontakt-organisation" name="organisation" type="text" autocomplete="organization" class="rounded-lg border border-line bg-paper px-4 py-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
          </div>
          <div class="grid gap-2">
            <label for="kontakt-mail" class="font-medium">E-Mail</label>
            <input id="kontakt-mail" name="email" type="email" autocomplete="email" required class="rounded-lg border border-line bg-paper px-4 py-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
          </div>
          <div class="grid gap-2">
            <label for="kontakt-nachricht" class="font-medium">Nachricht</label>
            <textarea id="kontakt-nachricht" name="nachricht" rows="5" required class="rounded-lg border border-line bg-paper px-4 py-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"></textarea>
          </div>
          <p class="text-sm text-ink-soft">Wir verwenden eure Angaben nur, um auf eure Anfrage zu antworten. Mehr dazu in der <a href="/datenschutzerklaerung/" class="underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-accent">Datenschutzerklärung</a>.</p>
          <div>
            <button type="submit" class="rounded-full bg-accent px-6 py-3 font-medium text-paper hover:bg-accent-strong focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">Nachricht senden</button>
          </div>
        </form>
      </section>

      <div class="grid content-start gap-8">
        <nav aria-label="Fusszeile">
          <h2 class="text-h3 font-semibold">Weiterlesen</h2>
          <ul class="mt-4 grid gap-3">
            <li><a href="/projekte/" class="underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">Individuelle Projekte</a></li>
            <li><a href="/wissenschaft/" class="underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">Wissenschaft</a></li>
            <li><a href="/ueber-restful/" class="underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">Über restful</a></li>
            <li><a href="#offene-stellen" class="underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">Offene Stellen</a></li>
            <li><a href="/datenschutzerklaerung/" class="underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">Datenschutz</a></li>
          </ul>
        </nav>
        <p class="text-sm text-ink-soft">restful GmbH, Bern</p>
      </div>
    </div>
  </footer>

  {% for script in scripts %}<script src="{{ script }}" defer></script>{% endfor %}
</body>
</html>
